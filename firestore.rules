rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.price is number && data.price >= 0
        && data.category is string && data.category.size() <= 64;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128
        && data.customerName is string && data.customerName.size() <= 150
        && data.customerPhone is string && data.customerPhone.size() <= 50
        && data.wilaya is string && data.wilaya.size() <= 100
        && data.totalAmount is number && data.totalAmount >= 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidProduct(request.resource.data);
      allow delete: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidOrder(request.resource.data);
      allow update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
